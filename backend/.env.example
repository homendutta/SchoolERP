APP_NAME="Asylinx School ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Single-tenant: one installation, one database, one domain per school.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (schema is designed in the Database Design phase — no tables yet)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schoolerp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Queues & cache (background jobs + caching strategy)
QUEUE_CONNECTION=database
CACHE_STORE=database

# Cross-cutting providers (configured per school via Settings; secrets stay here, never in code)
SMS_DRIVER=null
MAIL_MAILER=log
PUSH_DRIVER=null

# Payment gateways (test/live per gateway; pluggable)
PAYMENT_DEFAULT_GATEWAY=razorpay
PAYMENT_MODE=test

# Media library backend (local now; cloud/CDN-ready)
FILESYSTEM_DISK=local
