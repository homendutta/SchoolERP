      "id": "platform_readme_platform_infra_only_rule",
      "label": "Platform Infrastructure-Only Rule",
      "file_type": "rationale",
      "source_file": "C:\\SchoolERP\\backend\\app\\Platform\\README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Platform contains no business logic. Business behaviour (Settings, Number Generator, Import/Export, master data) lives in the Administration module, not Platform. Business modules depend on Platform; Platform depends on no business module. This enforces a clean dependency direction."
