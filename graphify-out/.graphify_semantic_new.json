    {
      "id": "backend_readme_module_communication_rule",
      "label": "Inter-Module Communication via Services and Domain Events Only",
      "file_type": "rationale",
      "source_file": "C:\\SchoolERP\\backend\\README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Modules must never reach into another module's data directly; they communicate via services and domain events to maintain loose coupling and clear module boundaries."
    },
